{
  "name": "portal-one",
  "version": "0.1.0",
  "description": "可运营的中英双语企业门户、管理端与 SQLite 服务",
  "license": "MIT",
  "type": "module",
  "bin": {
    "portal-one": "scripts/portal-one.js"
  },
  "files": [
    "admin/dist",
    "server/src",
    "web/dist",
    "web/src/locales",
    "web/src/mock",
    "scripts/build.js",
    "scripts/portal-one.js",
    "justfile",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "workspaces": [
    "web",
    "admin",
    "server"
